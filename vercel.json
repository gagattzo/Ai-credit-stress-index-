{
  "rewrites": [
    {
      "source": "/s/:id",
      "destination": "/api/share?id=:id"
    },
    {
      "source": "/lab",
      "destination": "/lab.html"
    },
    {
      "source": "/bdc",
      "destination": "/bdc.html"
    }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "{data.js,api/_fonts/**}",
      "memory": 1024,
      "maxDuration": 20
    },
    "api/share.js": {
      "includeFiles": "data.js"
    },
    "api/cds.js": {
      "maxDuration": 30
    },
    "api/lab.js": {
      "maxDuration": 15
    }
  }
}
